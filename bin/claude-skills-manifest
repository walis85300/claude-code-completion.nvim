#!/bin/sh
# claude-skills-manifest — Claude Code SessionStart hook
# Generates a JSON skills manifest by reusing the plugin's own Lua scanner.
# Only dependency: nvim (already installed — it's the editor this plugin runs in).
#
# Install: add to ~/.claude/settings.json:
#   "hooks": { "SessionStart": [{ "matcher": "startup", "command": "claude-skills-manifest" }] }

# Resolve symlinks to find the real plugin root (not the symlink location)
REAL_PATH="$0"
if command -v readlink >/dev/null 2>&1; then
  REAL_PATH=$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")
fi
SCRIPT_DIR="$(cd "$(dirname "$REAL_PATH")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

exec nvim --headless --clean \
  --cmd "set rtp+=$PLUGIN_ROOT" \
  -l "$PLUGIN_ROOT/lua/claude-code-completion/manifest.lua" \
  2>/dev/null
