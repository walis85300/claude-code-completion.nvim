#!/usr/bin/env bun
// claude-skills-manifest — Claude Code SessionStart hook
// Scans all skill sources and writes a JSON manifest for nvim completion.
// Install as a SessionStart hook in settings.json:
//   "hooks": { "SessionStart": [{ "matcher": "startup", "command": "claude-skills-manifest" }] }

import { readFileSync, readdirSync, statSync, writeFileSync, existsSync } from "fs";
import { join, basename, resolve } from "path";
import { createHash } from "crypto";
import { homedir, tmpdir } from "os";

// --- Types ---
interface Skill {
  name: string;
  description: string;
  source: "builtin" | "bundled" | "user" | "project" | "plugin";
  plugin?: string;
}

interface HookInput {
  session_id: string;
  cwd: string;
  hook_event_name: string;
  source: string;
}

// --- Built-in commands (user-facing subset from Claude Code source) ---
const BUILTINS: Array<{ name: string; description: string }> = [
  { name: "add-dir", description: "Add directories to context" },
  { name: "clear", description: "Clear conversation history" },
  { name: "compact", description: "Compact conversation to save context" },
  { name: "config", description: "View or modify configuration" },
  { name: "commit", description: "Create a git commit" },
  { name: "commit-push-pr", description: "Commit, push, and create a PR" },
  { name: "context", description: "Manage context files" },
  { name: "copy", description: "Copy last response to clipboard" },
  { name: "cost", description: "Show session cost" },
  { name: "desktop", description: "Open in desktop app" },
  { name: "diff", description: "Show file differences" },
  { name: "doctor", description: "Diagnose system issues" },
  { name: "exit", description: "Exit Claude Code" },
  { name: "fast", description: "Toggle fast mode" },
  { name: "feedback", description: "Send feedback" },
  { name: "files", description: "List tracked files" },
  { name: "help", description: "Show help" },
  { name: "ide", description: "IDE integration settings" },
  { name: "init", description: "Initialize project configuration" },
  { name: "keybindings", description: "Manage keyboard shortcuts" },
  { name: "login", description: "Sign in to your account" },
  { name: "logout", description: "Sign out" },
  { name: "mcp", description: "Manage MCP servers" },
  { name: "memory", description: "View and manage memory" },
  { name: "model", description: "Select model" },
  { name: "plan", description: "Toggle plan mode" },
  { name: "plugin", description: "Manage plugins" },
  { name: "pr-comments", description: "View PR comments" },
  { name: "permissions", description: "Manage permissions" },
  { name: "rename", description: "Rename session" },
  { name: "resume", description: "Resume a previous session" },
  { name: "review", description: "Code review" },
  { name: "security-review", description: "Security-focused code review" },
  { name: "session", description: "Session management" },
  { name: "skills", description: "List available skills" },
  { name: "status", description: "Show session status" },
  { name: "tasks", description: "Manage background tasks" },
  { name: "theme", description: "Change terminal theme" },
  { name: "usage", description: "Show API usage" },
  { name: "vim", description: "Toggle vim mode" },
];

const BUNDLED_SKILLS: Array<{ name: string; description: string }> = [
  { name: "simplify", description: "Review changed code for quality and fix issues" },
  { name: "debug", description: "Debug and diagnose issues" },
  { name: "verify", description: "Verify content accuracy" },
  { name: "remember", description: "Save information to memory" },
  { name: "batch", description: "Run operations in batch" },
  { name: "stuck", description: "Get help when stuck" },
  { name: "skillify", description: "Convert instructions to a reusable skill" },
  { name: "loop", description: "Run a command on a recurring interval" },
  { name: "schedule", description: "Schedule remote agent triggers" },
  { name: "claude-api", description: "Build apps with the Claude API" },
  { name: "update-config", description: "Update Claude Code configuration" },
];

// --- Frontmatter parser ---
function parseFrontmatter(content: string): Record<string, string> {
  const match = content.match(/^---\r?\n([\s\S]*?)\r?\n---/);
  if (!match) return {};
  const result: Record<string, string> = {};
  for (const line of match[1]!.split("\n")) {
    const kv = line.match(/^(\S+)\s*:\s*(.+)/);
    if (kv) {
      result[kv[1]!.trim()] = kv[2]!.trim().replace(/^["']|["']$/g, "");
    }
  }
  return result;
}

// --- Scan a directory for skill .md files ---
// Handles two layouts:
//   1. Flat: skills/*.md  (user/project skills)
//   2. Nested: skills/<name>/SKILL.md  (plugin skills)
function scanSkillDir(dir: string, source: Skill["source"], pluginName?: string): Skill[] {
  const skills: Skill[] = [];
  if (!existsSync(dir)) return skills;

  try {
    const entries = readdirSync(dir);
    for (const entry of entries) {
      const entryPath = join(dir, entry);
      try {
        const st = statSync(entryPath);

        if (st.isFile() && entry.endsWith(".md")) {
          // Flat layout: skills/foo.md
          const content = readFileSync(entryPath, "utf-8");
          const fm = parseFrontmatter(content);
          if (fm["user-invocable"] === "false") continue;
          const name = fm.name || basename(entry, ".md");
          const description = fm.description || "";
          skills.push({ name, description, source, ...(pluginName ? { plugin: pluginName } : {}) });

        } else if (st.isDirectory()) {
          // Nested layout: skills/<name>/SKILL.md
          const skillFile = join(entryPath, "SKILL.md");
          if (existsSync(skillFile) && statSync(skillFile).isFile()) {
            const content = readFileSync(skillFile, "utf-8");
            const fm = parseFrontmatter(content);
            if (fm["user-invocable"] === "false") continue;
            const name = fm.name || entry; // directory name as fallback
            const description = fm.description || "";
            skills.push({ name, description, source, ...(pluginName ? { plugin: pluginName } : {}) });
          }
        }
      } catch {
        // skip unreadable entries
      }
    }
  } catch {
    // skip unreadable directories
  }
  return skills;
}

// --- Scan plugin directories ---
function scanPluginSkills(claudeDir: string): Skill[] {
  const skills: Skill[] = [];

  // Direct plugins: ~/.claude/plugins/cache/{marketplace}/{plugin}/{version}/
  const cacheDir = join(claudeDir, "plugins", "cache");
  if (existsSync(cacheDir)) {
    try {
      for (const marketplace of readdirSync(cacheDir)) {
        const mDir = join(cacheDir, marketplace);
        if (!statSync(mDir).isDirectory()) continue;
        for (const plugin of readdirSync(mDir)) {
          const pDir = join(mDir, plugin);
          if (!statSync(pDir).isDirectory()) continue;
          for (const version of readdirSync(pDir)) {
            const vDir = join(pDir, version);
            const skillsDir = join(vDir, "skills");
            skills.push(...scanSkillDir(skillsDir, "plugin", `${marketplace}/${plugin}`));
          }
        }
      }
    } catch {
      // skip
    }
  }

  // Marketplace plugins: ~/.claude/plugins/marketplaces/*/plugins/*/skills/
  const marketplacesDir = join(claudeDir, "plugins", "marketplaces");
  if (existsSync(marketplacesDir)) {
    try {
      for (const marketplace of readdirSync(marketplacesDir)) {
        const pluginsDir = join(marketplacesDir, marketplace, "plugins");
        if (!existsSync(pluginsDir)) continue;
        for (const plugin of readdirSync(pluginsDir)) {
          const skillsDir = join(pluginsDir, plugin, "skills");
          skills.push(...scanSkillDir(skillsDir, "plugin", `${marketplace}:${plugin}`));
        }
      }
    } catch {
      // skip
    }
  }

  return skills;
}

// --- Main ---
function main() {
  // Read hook input from stdin
  let cwd = process.cwd();
  try {
    const input = readFileSync("/dev/stdin", "utf-8").trim();
    if (input) {
      const hookInput: HookInput = JSON.parse(input);
      if (hookInput.cwd) cwd = hookInput.cwd;
    }
  } catch {
    // If no stdin (manual invocation), use process.cwd()
  }

  const home = homedir();
  const claudeDir = join(home, ".claude");
  const allSkills: Skill[] = [];

  // 1. Built-in commands
  for (const cmd of BUILTINS) {
    allSkills.push({ ...cmd, source: "builtin" });
  }

  // 2. Bundled skills
  for (const skill of BUNDLED_SKILLS) {
    allSkills.push({ ...skill, source: "bundled" });
  }

  // 3. User skills
  allSkills.push(...scanSkillDir(join(claudeDir, "skills"), "user"));

  // 4. Project skills (cwd-dependent!)
  allSkills.push(...scanSkillDir(join(cwd, ".claude", "skills"), "project"));

  // 5. Plugin skills
  allSkills.push(...scanPluginSkills(claudeDir));

  // Write manifest
  const cwdHash = createHash("sha256").update(cwd).digest("hex").slice(0, 12);
  const manifestPath = join(tmpdir(), `claude-skills-${cwdHash}.json`);

  const manifest = {
    version: 1,
    cwd,
    generated_at: new Date().toISOString(),
    skills: allSkills,
  };

  writeFileSync(manifestPath, JSON.stringify(manifest, null, 2));

  // Also write to a "latest" symlink for easy discovery
  const latestPath = join(tmpdir(), "claude-skills-latest.json");
  writeFileSync(latestPath, JSON.stringify(manifest, null, 2));
}

main();
